# HealthSaathi Server Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/healthsaathi
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthsaathi
MONGODB_URI=mongodb://localhost:27017/healthsaathi

# JWT Secret Key (change this to a long random string in production)
JWT_SECRET=healthsaathi-jwt-secret-key-change-in-production

# Server Port
PORT=3000

# Optional: Supabase (leave empty if not using)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
